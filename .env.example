# Copy to `.env` (git-ignored). Every variable is optional; defaults are in src/msl/config.py.

# Where raw Parquet lands. Inside Docker this is always /app/data (bind-mounted to ./data).
MSL_DATA_DIR=./data

# First date to ingest. Research starts 2005-01-01; one extra year warms up 252-day lookbacks.
MSL_DEFAULT_START=2004-01-01

# Databricks — used by `msl lakehouse check|upload`. Never commit real values.
# HOST: your workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# TOKEN: a personal access token (Settings -> Developer -> Access tokens). Leave TOKEN empty
#        to sign in through the browser instead (OAuth; works natively, not inside Docker).
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Where the raw landing zone is mirrored: /Volumes/<catalog>/<schema>/<volume>
MSL_VOLUME=/Volumes/workspace/default/raw
